+            "name": "Assistant"
+        }"#;
+
+        let msg: ChatMessage = serde_json::from_str(json).unwrap();
+        assert!(matches!(msg.role, ChatMessageRole::Assistant));
+        assert!(msg.tool_calls.is_some());
+        assert_eq!(msg.name, Some("Assistant".to_string()));
+    }
+}
