+
+    let client = Client::builder()
+        .timeout(Duration::from_secs(10))
+        .build()
+        .unwrap();
+
+    let request_body = json!({
+        "model": "gpt-4",
+        "messages": [
+            {"role": "user", "content": "Hello!"}
