+    assert_eq!(usage["prompt_tokens"], 10);
+    assert_eq!(usage["completion_tokens"], 5);
+    assert_eq!(usage["total_tokens"], 15);
+
+    // Verify upstream was hit
+    assert!(mock.request_count.load(Ordering::SeqCst) >= 1);
+}
